{
  "DatabaseSettings": {
    "Hostname": "localhost",
    "Keyspace": "kusers",
    "Port": "9042"
  },
  "Authentication": {
    "JWT": {
      "Issuer": "ms.users",
      "PrivateKeyPath": ".keys/jwt-signing.pem",
      "AccessTokenMinutes": 15
    },
    "Session": {
      "IdleDays": 7,
      "AbsoluteDays": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
